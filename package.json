{
  "name": "werewolf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/arena"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm -w @werewolf/server run dev",
    "dev:client": "npm -w @werewolf/client run dev",
    "build": "npm -w @werewolf/client run build",
    "start": "npm -w @werewolf/server run start",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --pretty",
    "arena": "npm -w @werewolf/arena run arena --",
    "arena:analyze": "npm -w @werewolf/arena run analyze --",
    "arena:annotate": "npm -w @werewolf/arena run annotate --",
    "arena:tournament": "npm -w @werewolf/arena run tournament --",
    "arena:sweep": "npm -w @werewolf/arena run sweep --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "vite": "^6.0.0"
  }
}
